{
  "name": "sundrift-android",
  "private": true,
  "version": "1.0.0",
  "description": "Sundrift Android app (Capacitor wrapper around ../index.html)",
  "scripts": {
    "copy-web": "node -e \"require('fs').mkdirSync('www',{recursive:true});require('fs').copyFileSync('../index.html','www/index.html')\"",
    "sync": "npm run copy-web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
